# Copy to .env for docker compose variable substitution.
# Keep this file out of version control.

# Initial admin password for automated deployments (minimum 8 characters).
# Leave unset to use the browser setup page on first start.
#TICKWATCH_ADMIN_PASSWORD=change-me-before-first-start

# Public base URL of this instance, used in heartbeat ping URLs and alerts.
#TICKWATCH_BASE_URL=https://tickwatch.example.com
